{
  "name": "stuttter/wp-user-groups",
  "description": "Group users together with taxonomies & terms",
  "homepage": "https://github.com/stuttter/wp-user-groups",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^1.12 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5.48 || ^9.6"
  },
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "John James Jacoby",
      "email": "johnjamesjacoby@me.com"
    }
  ],
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  }
}
